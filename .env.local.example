# Vercel KV (Upstash Redis) — set automatically when you connect a KV
# store in the Vercel dashboard. For local dev, run `vercel env pull .env.local`
# after linking the project, or paste the values from Upstash here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for the parent moderation page at /admin
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
